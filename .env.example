# ---------------------------------------------------------------------------
# Ovelia storefront — environment variables
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public base URL of the site (used for links in emails, SEO, auth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Database ---------------------------------------------------------------
# MongoDB Atlas (recommended) or the local database started by `npm run db:dev`.
MONGODB_URI=mongodb+srv://daxitgodhaniwork_db_user:e4d3lM8NmtRI7Rmu@ovelia.kfvojm7.mongodb.net/?appName=Ovelia
# Database name (defaults to ovelia)
MONGODB_DB_NAME=ovelia
# auto | true | false — "auto" detects replica-set support for multi-document transactions
MONGODB_TRANSACTIONS=auto

# --- Authentication (Better Auth) -------------------------------------------
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3100

# --- Payments (Razorpay) ----------------------------------------------------
# Use test-mode keys during development (rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured for the webhook endpoint: <site>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend
EMAIL_FROM="Ovelia <orders@example.com>"
EMAIL_REPLY_TO=

# --- Images (Cloudinary) ----------------------------------------------------
# If unset, admin uploads are stored in public/uploads (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ovelia

# --- Shipping (Shiprocket, optional) ----------------------------------------
# Leave blank to use manual courier entry only.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as configured in your Shiprocket panel
SHIPROCKET_PICKUP_LOCATION=
# Token you configure in Shiprocket's webhook settings (sent as x-api-key)
SHIPROCKET_WEBHOOK_TOKEN=

# --- Scheduled jobs ---------------------------------------------------------
# Bearer token required by /api/cron/* endpoints
CRON_SECRET=

# --- Misc -------------------------------------------------------------------
# Autofill city/state from PIN code using the public India Post API (on|off)
PINCODE_LOOKUP=on

# --- Seeding ----------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Store Owner
